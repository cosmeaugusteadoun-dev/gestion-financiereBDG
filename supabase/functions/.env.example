# Copier dans .env (ignoré par Git) ou saisir dans Supabase > Edge Functions > Secrets.
# Ne jamais mettre ces valeurs dans assets/js/config.js ou dans la conversation.
WHATSAPP_TOKEN=REMPLACER_PAR_LE_TOKEN_META
WHATSAPP_PHONE_NUMBER_ID=REMPLACER_PAR_LE_PHONE_NUMBER_ID
# Reprendre la version du Graph API affichée dans votre exemple Meta.
WHATSAPP_GRAPH_VERSION=REMPLACER_PAR_LA_VERSION_META
# UUID du compte Supabase Auth autorisé à envoyer ; plusieurs UUID séparés par virgule.
WHATSAPP_ADMIN_USER_IDS=REMPLACER_PAR_UUID_AUTH
# Origine exacte, sans slash final (exemple local ci-dessous).
WHATSAPP_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Laisser [] tant qu'aucun modèle n'est approuvé ; pas d'envoi possible.
WHATSAPP_TEMPLATES_JSON=[]
